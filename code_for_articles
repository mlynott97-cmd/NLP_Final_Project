from pathlib import Path
import csv
import re
import shutil
import subprocess
import tempfile


# Exact input and output filenames
input_file = Path("Files(500) (2).RTF")
output_file = Path("Chevalier.csv")


# Patterns used to identify dates, body labels, images, and URLs
date_pattern = re.compile(
    r"^(January|February|March|April|May|June|July|August|September|October|November|December)"
    r"\s+\d{1,2},\s+\d{4}\b"
)

body_pattern = re.compile(r"^Body(?:_\d+)?(?:Body)?$")
picture_pattern = re.compile(r"pict\d+\.jpg", flags=re.IGNORECASE)
url_pattern = re.compile(r"https?://\S+")


def convert_rtf_to_text(rtf_path):
    """
    Converts the LexisNexis RTF file into plain text.

    On a Mac, this uses textutil, which is already installed.
    """

    if shutil.which("textutil"):

        with tempfile.NamedTemporaryFile(
            suffix=".txt",
            delete=False
        ) as temporary_file:

            text_path = Path(temporary_file.name)

        try:
            subprocess.run(
                [
                    "textutil",
                    "-convert",
                    "txt",
                    "-output",
                    str(text_path),
                    str(rtf_path)
                ],
                check=True,
                capture_output=True,
                text=True
            )

            text = text_path.read_text(
                encoding="utf-8",
                errors="ignore"
            )

            return text

        finally:
            text_path.unlink(missing_ok=True)

    else:
        raise RuntimeError(
            "This script requires textutil. "
            "textutil is included automatically on Mac computers."
        )


def clean_line(line):
    """
    Cleans individual lines from the converted LexisNexis text.
    """

    # Remove picture labels such as pict1.jpg
    line = picture_pattern.sub("", line)

    # Replace non-breaking spaces
    line = line.replace("\xa0", " ")

    # Replace repeated spaces with one space
    line = re.sub(r"\s+", " ", line)

    return line.strip()


def parse_lexis_text(text):
    """
    Extracts the publication date, media outlet, title,
    and article body from each LexisNexis document.
    """

    lines = []

    for line in text.splitlines():
        lines.append(clean_line(line))

    articles = []

    # Search for every Lexis body marker
    for body_index, line in enumerate(lines):

        # Lexis may call the body:
        # Body
        # Body_3
        # Body_3Body
        if not body_pattern.fullmatch(line):
            continue

        # Find the publication date above the Body line
        date_index = None

        for i in range(
            body_index - 1,
            max(-1, body_index - 35),
            -1
        ):

            if date_pattern.match(lines[i]):
                date_index = i
                break

        # Skip the document if no publication date is found
        if date_index is None:
            continue

        date_match = date_pattern.match(lines[date_index])

        if date_match is None:
            continue

        date_of_publication = date_match.group(0)

        # The outlet and title are normally the two useful lines
        # immediately above the publication date
        candidates = []

        for i in range(
            date_index - 1,
            max(-1, date_index - 25),
            -1
        ):

            value = lines[i]

            if not value:
                continue

            # Skip URLs
            if url_pattern.fullmatch(value):
                continue

            if value.startswith("http"):
                continue

            # Skip Lexis labels
            if value in {
                "WebNews - Academic",
                "WebNews - English",
                "WebNews - Spanish"
            }:
                continue

            if value.startswith("Page of"):
                continue

            if value.startswith("Bookmark_"):
                continue

            candidates.append(value)

            if len(candidates) == 2:
                break

        # Skip the document if the outlet and title cannot be found
        if len(candidates) < 2:
            continue

        media_outlet = candidates[0]
        title = candidates[1]

        # Extract the body until the Classification section
        body_lines = []

        i = body_index + 1

        while i < len(lines):

            value = lines[i]

            if value.startswith("Classification"):
                break

            if value.startswith("End of Document"):
                break

            if value and not value.startswith("###"):
                body_lines.append(value)

            i += 1

        # Join the article body into one string
        body = " ".join(body_lines)

        # Remove repeated whitespace
        body = re.sub(r"\s+", " ", body).strip()

        articles.append(
            {
                "date_of_publication": date_of_publication,
                "media_outlet": media_outlet,
                "title": title,
                "body": body
            }
        )

    return articles


# Confirm that the input file exists
if not input_file.exists():
    raise FileNotFoundError(
        f"Could not find the file: {input_file}"
    )


# Convert the RTF file into text
plain_text = convert_rtf_to_text(input_file)


# Extract the articles
articles = parse_lexis_text(plain_text)


# Check that exactly 500 articles were extracted
if len(articles) != 500:
    raise ValueError(
        f"Expected 500 articles, but extracted {len(articles)}."
    )


# Write the results to Chevalier.csv
with output_file.open(
    "w",
    newline="",
    encoding="utf-8-sig"
) as csv_file:

    fieldnames = [
        "date_of_publication",
        "media_outlet",
        "title",
        "body"
    ]

    writer = csv.DictWriter(
        csv_file,
        fieldnames=fieldnames
    )

    writer.writeheader()
    writer.writerows(articles)


print(f"Created {output_file}")
print(f"Number of rows: {len(articles)}")
